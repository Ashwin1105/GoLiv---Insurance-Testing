{
  "name": "insureco-portal-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript + Cucumber BDD automation for InsureCo Portal",
  "scripts": {
    "test": "cucumber-js",
    "test:headed": "cucumber-js --format progress",
    "test:report": "cucumber-js --format progress",
    "playwright:install": "playwright install --with-deps",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@playwright/test": "^1.48.2",
    "@cucumber/cucumber": "^10.9.0",
    "allure-cucumberjs": "^3.10.2"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "ts-node": "^10.9.2"
  }
}
