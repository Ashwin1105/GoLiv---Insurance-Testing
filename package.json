{
  "name": "qa-automation-insurance",
  "version": "1.0.0",
  "description": "Deterministic Playwright-BDD (Cucumber-JS) automation",
  "scripts": {
    "test": "cucumber-js \"src/features/**/*.feature\" --require-module ts-node/register --require \"src/steps/**/*.ts\" --format junit:test-results/results.xml"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.9.0",
    "@playwright/test": "^1.44.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "tsconfig-paths": "^4.2.0"
  }
}
