{
  "name": "insureco-portal-tests",
  "version": "1.0.0",
  "description": "Automated tests for InsureCo Portal using Playwright, Cucumber, and Allure",
  "scripts": {
    "test": "cucumber-js --require-module ts-node/register --require ./steps/**/*.ts",
    "playwright": "playwright test",
    "allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "allure open ./allure-report"
  },
  "dependencies": {
    "@playwright/test": "^1.45.0",
    "@cucumber/cucumber": "^10.9.0",
    "allure-cucumberjs": "^3.10.2"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "ts-node": "^10.9.0",
    "@types/node": "^20.14.0"
  }
}
