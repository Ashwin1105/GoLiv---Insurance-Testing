{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node", "@cucumber/cucumber", "@playwright/test"]
  },
  "ts-node": {
    "transpileOnly": true
  },
  "include": [
    "features/**/*.ts",
    "features/**/*.js",
    "tests/**/*.ts",
    "tests/**/*.js",
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}