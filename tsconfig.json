{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": ".",
    "moduleResolution": "node",
    "sourceMap": true,
    "noEmitOnError": true
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "features/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}